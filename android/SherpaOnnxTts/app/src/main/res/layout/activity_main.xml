<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header Card: Voice & Backend Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0F4F8"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sherpa-ONNX TTS (Samsung Galaxy S25 Ultra)"
                android:textColor="#102A43"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Explicit Voice Selector -->
            <RadioGroup
                android:id="@+id/rg_voices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_voice_narrateur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🎙️ Français : Narrateur (Modèle personnalisé Drive)"
                    android:textColor="#1B4D3E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rb_voice_en"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ NPU Qualcomm Hexagon V79 : English (Amy)"
                    android:textColor="#0B69A3"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rb_voice_fr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🇫🇷 CPU ONNX Runtime : Français (Siwis)"
                    android:textColor="#334E68"
                    android:textSize="12sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/tv_backend_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Backend: En cours d'initialisation..."
                android:textColor="#243B53"
                android:textSize="13sp"
                android:textStyle="italic" />

            <!-- Mode Selector Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mode: "
                    android:textColor="#334E68"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_mode_auto"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:text="Auto"
                    android:textAllCaps="false"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_mode_npu"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:text="NPU QNN"
                    android:textAllCaps="false"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_mode_cpu"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="CPU ONNX"
                    android:textAllCaps="false"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Acoustic & Rhythm Sliders Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F7F9FC"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎚️ Paramètres Acoustiques (Anti-Métallique)"
                android:textColor="#102A43"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Slider 1: Speed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_speed_val"
                    android:layout_width="165dp"
                    android:layout_height="wrap_content"
                    android:text="Vitesse : 1.00x"
                    android:textColor="#243B53"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sb_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="150"
                    android:progress="50" />
            </LinearLayout>

            <!-- Slider 2: Noise Scale (Timbre / Grain) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_noise_scale_val"
                    android:layout_width="165dp"
                    android:layout_height="wrap_content"
                    android:text="Bruit Timbre (noise) : 0.35"
                    android:textColor="#1B4D3E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/sb_noise_scale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="35" />
            </LinearLayout>

            <!-- Slider 3: Noise W (Variation Rythme / Durée) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_noise_w_val"
                    android:layout_width="165dp"
                    android:layout_height="wrap_content"
                    android:text="Bruit Rythme (noise_w) : 0.33"
                    android:textColor="#1B4D3E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/sb_noise_w"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="33" />
            </LinearLayout>

            <!-- Slider 4: Silence Scale (Pauses) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_silence_val"
                    android:layout_width="165dp"
                    android:layout_height="wrap_content"
                    android:text="Pauses (silence) : 0.20"
                    android:textColor="#243B53"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sb_silence"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="20" />
            </LinearLayout>

            <!-- Preset Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_preset_smooth"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="✨ Doux (0.33 / 0.33)"
                    android:textAllCaps="false"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_preset_narrateur"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="🎙️ Config (0.50 / 0.33)"
                    android:textAllCaps="false"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_preset_standard"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="🔊 Piper (0.67 / 0.80)"
                    android:textAllCaps="false"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Hidden SID & Speed EditTexts for backward compatibility -->
            <EditText
                android:id="@+id/sid"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:inputType="number"
                android:text="0"
                android:visibility="gone" />

            <EditText
                android:id="@+id/speed"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:inputType="numberDecimal"
                android:text="1.0"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Text Input -->
        <EditText
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:hint="@string/text_hint"
            android:inputType="textMultiLine"
            android:lines="4"
            android:maxLines="8"
            android:minLines="3"
            android:scrollbars="vertical" />

        <!-- Generation & Playback Buttons -->
        <Button
            android:id="@+id/generate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:text="@string/generate"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/play"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:text="@string/play"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/stop"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:text="@string/stop"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/save_share_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:text="@string/save"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/share"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:text="@string/share"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Diagnostics & Debug Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Console de Diagnostic &amp; Debug"
                    android:textColor="#00FF66"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_copy_logs"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="2dp"
                    android:backgroundTint="#0D47A1"
                    android:text="📋 Copier Logs"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_clear_logs"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:backgroundTint="#424242"
                    android:text="🗑️"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_perf_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Status: En attente"
                android:textColor="#CCCCCC"
                android:textSize="11sp" />

            <ScrollView
                android:id="@+id/scroll_log"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="4dp"
                android:background="#121212"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tv_debug_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="En attente des logs..."
                    android:textColor="#81C784"
                    android:textIsSelectable="true"
                    android:textSize="10sp" />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>